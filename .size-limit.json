[
  {
    "name": "main window startup JS (eager modulepreload)",
    "path": [
      "dist/assets/main-*.js",
      "dist/assets/react-*.js",
      "dist/assets/radix-*.js",
      "dist/assets/alert-dialog-*.js",
      "dist/assets/xterm-*.js"
    ],
    "limit": "540 KB",
    "gzip": true
  },
  {
    "name": "total client JS (lazy chunks included; raised over upstream for the fork's SSH, panes and agent features)",
    "path": ["dist/assets/*.js"],
    "limit": "1650 KB",
    "gzip": true
  }
]
